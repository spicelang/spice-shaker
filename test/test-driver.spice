import "std/text/print";
import "../src/driver";

const int EXIT_SUCCESS = 0;

#[test, test.name="Test root command"]
f<bool> testRootCommand() {
  // Prepare driver
  Driver driver;

  // Help text
  dyn argv = ["spice-shaker", "--help"];
  int argc = cast<int>(len(argv));
  assert driver.parse(argc, argv) == EXIT_SUCCESS;

  return true;
}

#[test, test.name="Test install subcommand"]
f<bool> testInstallSubcommand() {
  // Prepare driver
  Driver driver;

  // Help text
  dyn argv = ["spice-shaker", "install", "--help"];
  int argc = cast<int>(len(argv));
  assert driver.parse(argc, argv) == EXIT_SUCCESS;

  return true;
}

#[test, test.name="Test uninstall subcommand"]
f<bool> testUninstallSubcommand() {
  // Prepare driver
  Driver driver;

  // Help text
  dyn argv = ["spice-shaker", "uninstall", "--help"];
  int argc = cast<int>(len(argv));
  assert driver.parse(argc, argv) == EXIT_SUCCESS;

  return true;
}