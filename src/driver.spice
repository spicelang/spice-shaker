// Std imports
import "std/io/cli-parser";
import "std/io/cli-subcommand";

// Own imports
import "./commands";

public const string SHAKER_VERSION = "v0.2.0";

public type CliOptions struct {
    InstallRequest install
    String dependencyName
    String query
}

public p CliOptions.ctor() {}

public type Driver struct {
    CliParser parser
    CliOptions options
    int exitCode = 0
}

public p Driver.ctor() {
    Driver* self = this;
    this.parser = CliParser("Spice Shaker", "Official package manager for the Spice programming language");
    this.parser.setVersion(SHAKER_VERSION);
    this.parser.setFooter("Copyright (c) Marc Auberer 2021-2026");

    // Init subcommand
    CliSubcommand& init = this.parser.addSubcommand("init", "Create a spice.toml in the current directory");
    init.setCallback(p() {
        self.exitCode = runInit();
    });

    // Install subcommand
    CliSubcommand& install = this.parser.addSubcommand("install", "Install a dependency and add it to spice.toml");
    install.addOption("package", this.options.install.target, "Package name, owner/repo with --github, or a directory with --path");
    install.addOption("--version", this.options.install.version, "Version constraint of a registry package (e.g. ^1.2.0)");
    install.addOption("--rev", this.options.install.rev, "Tag, branch or commit of a GitHub repository");
    install.addOption("--as", this.options.install.name, "Dependency name for a GitHub or path dependency");
    install.addFlag("--github", this.options.install.github, "Install from a GitHub repository");
    install.addFlag("--path", this.options.install.path, "Install from a local directory");
    install.addFlag("--dev", this.options.install.dev, "Add the dependency to [dev-dependencies]");
    install.setCallback(p() {
        self.exitCode = runInstall(self.options.install);
    });

    // Uninstall subcommand
    CliSubcommand& uninstall = this.parser.addSubcommand("uninstall", "Uninstall a dependency and remove it from spice.toml");
    this.addDependencyNameOption(uninstall);
    uninstall.setCallback(p() {
        self.exitCode = runUninstall(self.options.dependencyName);
    });

    // Sync subcommand
    CliSubcommand& syncCmd = this.parser.addSubcommand("sync", "Install all dependencies of spice.toml (honors spice.lock)");
    syncCmd.setCallback(p() {
        self.exitCode = runSync();
    });

    // Update subcommand
    CliSubcommand& update = this.parser.addSubcommand("update", "Update all dependencies to the newest versions allowed by spice.toml");
    update.setCallback(p() {
        self.exitCode = runUpdate();
    });

    // List subcommand
    CliSubcommand& list = this.parser.addSubcommand("list", "Show the installed dependencies as a tree");
    list.setCallback(p() {
        self.exitCode = runList();
    });

    // Search subcommand
    CliSubcommand& search = this.parser.addSubcommand("search", "Search for packages in the registry");
    search.addOption("query", this.options.query, "Search term");
    search.setCallback(p() {
        self.exitCode = runSearch(self.options.query, 1l);
    });

    // Info subcommand
    CliSubcommand& info = this.parser.addSubcommand("info", "Show details and versions of a package in the registry");
    this.addDependencyNameOption(info);
    info.setCallback(p() {
        self.exitCode = runInfo(self.options.dependencyName);
    });
}

public p Driver.addDependencyNameOption(CliSubcommand& subcommand) {
    subcommand.addOption("package", this.options.dependencyName, "Package name");
}

public f<int> Driver.parse(int argc, string[] argv) {
    const int parseResult = this.parser.parse(argc, argv);
    if parseResult != 0 { return parseResult; }
    return this.exitCode;
}

#[test]
f<bool> testHelpOfAllCommands() {
    const string[8] commands = ["init", "install", "uninstall", "sync", "update", "list", "search", "info"];
    for unsigned int i = 0u; i < 8u; i++ {
        Driver driver;
        string[3] argv = ["spice-shaker", commands[i], "--help"];
        assert driver.parse(3, argv) == 0;
    }
    Driver rootDriver;
    string[2] rootArgv = ["spice-shaker", "--help"];
    assert rootDriver.parse(2, rootArgv) == 0;
    return true;
}
