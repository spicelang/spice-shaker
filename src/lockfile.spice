// Std imports
import "std/data/map";
import "std/data/pair";
import "std/data/vector";
import "std/io/file";
import "std/text/toml/toml-value";
import "std/text/toml/toml-parser";
import "std/text/toml/toml-serializer";

// Own imports
import "./util";

// ---------------------------------------------------------------------------------------------------------------------
// The lock file spice.lock: which version of which package is installed, where it came from and what it depends on.
// The format is specified in media/manifest-spec.md.
// ---------------------------------------------------------------------------------------------------------------------

public const string LOCK_FILE = "spice.lock";
const long LOCK_VERSION = 1l;
const string LOCK_HEADER = "# This file is generated by Spice Shaker. Do not edit it by hand.\n";

public type LockEntry struct {
    public String name
    public String source   // "registry", "github:owner/repo" or "path:<path>"
    public String version  // Registry: resolved version, GitHub: requested ref
    public String commit   // GitHub only
    public String checksum // Registry and GitHub
    public Vector<String> dependencies
}

public f<bool> LockEntry.isPath() {
    return this.source.startsWith("path:");
}

/**
 * Version as shown to users: the version, or the ref and the short commit of a GitHub package
 */
public f<String> LockEntry.display() {
    if this.isPath() { return this.source.getSubstring(5l); }
    if this.commit.isEmpty() { return this.version; }
    return this.version + " (" + head(this.commit, 7l) + ")";
}

public type Lockfile struct {
    public Map<String, LockEntry> entries // Sorted by name, like the file
}

public f<bool> Lockfile.contains(const String& name) {
    return this.entries.contains(name);
}

/**
 * The entry of a package, or an empty entry if it is not locked
 */
public f<LockEntry> Lockfile.get(const String& name) {
    if !this.entries.contains(name) { return LockEntry(); }
    return this.entries.get(name);
}

public p Lockfile.set(const LockEntry& entry) {
    this.entries.upsert(entry.name, entry);
}

public p Lockfile.drop(const String& name) {
    if this.entries.contains(name) { this.entries.remove(name); }
}

public f<Vector<String>> Lockfile.getNames() {
    Vector<String> names;
    foreach Pair<const String&, LockEntry&> item : this.entries { names.pushBack(item.getFirst()); }
    return names;
}

f<bool> readLockString(TomlValue* table, string key, String& target) {
    TomlValue* value = table.getFieldOrNil(key);
    if value == nil<TomlValue*> { return true; }
    if !value.isString() { return false; }
    target = value.getString();
    return true;
}

f<bool> isValidSource(const String& source) {
    if source == "registry" { return true; }
    if source.startsWith("github:") { return isValidGithubRepo(source.getSubstring(7l)); }
    return source.startsWith("path:") && source.getLength() > 5l;
}

f<bool> readLockEntry(TomlValue* item, LockEntry& entry) {
    if !item.isTable() { return false; }
    bool valid = readLockString(item, "name", entry.name) && readLockString(item, "source", entry.source);
    valid = valid && readLockString(item, "version", entry.version) && readLockString(item, "commit", entry.commit);
    valid = valid && readLockString(item, "checksum", entry.checksum);
    // The names end up in paths, so they are checked like the ones in the manifest
    valid = valid && isValidPackageName(entry.name) && isValidSource(entry.source);
    TomlValue* deps = item.getFieldOrNil("dependencies");
    if deps != nil<TomlValue*> && valid {
        if !deps.isArray() { return false; }
        for unsigned long i = 0l; i < deps.getArraySize(); i++ {
            TomlValue* dep = deps.getArrayItem(i);
            if !dep.isString() || !isValidPackageName(dep.getString()) { return false; }
            entry.dependencies.pushBack(dep.getString());
        }
    }
    return valid;
}

/**
 * Parse the content of a lock file. On failure, `error` says why.
 */
public f<bool> Lockfile.parse(const String& text, String& error) {
    Result<TomlValue*> parsed = parseToml(text);
    if parsed.isErr() {
        const Error& parseError = parsed.getErr();
        error = String(LOCK_FILE) + " is not valid TOML: " + parseError.getMessage();
        return false;
    }
    TomlValue* root = parsed.unwrap();
    TomlValue* version = root.getFieldOrNil("version");
    bool valid = version != nil<TomlValue*> && version.isInteger() && version.getInteger() == LOCK_VERSION;
    if !valid {
        error = String(LOCK_FILE) + " has an unsupported format version. It was written by another version of Spice Shaker.";
        deleteTomlValue(root);
        return false;
    }
    TomlValue* packages = root.getFieldOrNil("package");
    if packages != nil<TomlValue*> {
        valid = packages.isArray();
        for unsigned long i = 0l; valid && i < packages.getArraySize(); i++ {
            LockEntry entry;
            valid = readLockEntry(packages.getArrayItem(i), entry);
            if valid { this.set(entry); }
        }
    }
    deleteTomlValue(root);
    if !valid { error = String(LOCK_FILE) + " is corrupt. Delete it and run 'spice-shaker sync' to create it again."; }
    return valid;
}

/**
 * Read the lock file. A missing file is an empty lock file.
 */
public f<bool> Lockfile.load(String& error, const String& path = String(LOCK_FILE)) {
    if !fileExists(path.getRaw()) { return true; }
    Result<String> content = readFile(path.getRaw());
    if content.isErr() {
        error = String("Could not read ") + path;
        return false;
    }
    return this.parse(content.unwrap(), error);
}

p addLockString(TomlValue* table, string key, const String& value) {
    if !value.isEmpty() { table.addTableField(String(key), __new<TomlValue>(value)); }
}

public f<String> Lockfile.serialize() {
    TomlValue* root = __new<TomlValue>(TomlValueKind::TOML_TABLE);
    root.addTableField(String("version"), __new<TomlValue>(LOCK_VERSION));
    TomlValue* packages = __new<TomlValue>(TomlValueKind::TOML_ARRAY);
    foreach Pair<const String&, LockEntry&> item : this.entries {
        const LockEntry& entry = item.getSecond();
        TomlValue* table = __new<TomlValue>(TomlValueKind::TOML_TABLE);
        addLockString(table, "name", entry.name);
        addLockString(table, "source", entry.source);
        addLockString(table, "version", entry.version);
        addLockString(table, "commit", entry.commit);
        addLockString(table, "checksum", entry.checksum);
        Vector<String> deps = entry.dependencies;
        sortStrings(deps);
        TomlValue* depArray = __new<TomlValue>(TomlValueKind::TOML_ARRAY);
        for unsigned long i = 0l; i < deps.getSize(); i++ { depArray.addArrayItem(__new<TomlValue>(deps.get(i))); }
        table.addTableField(String("dependencies"), depArray);
        packages.addArrayItem(table);
    }
    root.addTableField(String("package"), packages);
    TomlSerializer serializer;
    const String text = String(LOCK_HEADER) + serializer.serialize(root);
    deleteTomlValue(root);
    return text;
}

public f<bool> Lockfile.save(const String& path = String(LOCK_FILE)) {
    return writeTextFile(path, this.serialize());
}

#[test]
f<bool> testLockfileRoundTrip() {
    Lockfile lock;
    LockEntry b;
    b.name = String("b");
    b.source = String("github:owner/B.repo");
    b.version = String("HEAD");
    b.commit = String("0123456789abcdef0123456789abcdef01234567");
    b.checksum = String("sha256-tree:00");
    b.dependencies.pushBack(String("z"));
    b.dependencies.pushBack(String("a"));
    lock.set(b);
    LockEntry a;
    a.name = String("a");
    a.source = String("registry");
    a.version = String("2.1.0");
    lock.set(a);
    a.version = String("2.2.0");
    lock.set(a);
    LockEntry local;
    local.name = String("local");
    local.source = String("path:../local");
    lock.set(local);
    assert lock.entries.getSize() == 3l;

    const String text = lock.serialize();
    assert text == "# This file is generated by Spice Shaker. Do not edit it by hand.\nversion = 1\n\n" +
                   "[[package]]\nname = \"a\"\nsource = \"registry\"\nversion = \"2.2.0\"\ndependencies = []\n\n" +
                   "[[package]]\nname = \"b\"\nsource = \"github:owner/B.repo\"\nversion = \"HEAD\"\n" +
                   "commit = \"0123456789abcdef0123456789abcdef01234567\"\nchecksum = \"sha256-tree:00\"\ndependencies = [\"a\", \"z\"]\n\n" +
                   "[[package]]\nname = \"local\"\nsource = \"path:../local\"\ndependencies = []\n";

    Lockfile reread;
    String error;
    assert reread.parse(text, error);
    assert reread.entries.getSize() == 3l;
    const LockEntry rereadB = reread.get(String("b"));
    assert rereadB.commit == b.commit && rereadB.dependencies.getSize() == 2l;
    assert rereadB.display() == "HEAD (0123456)";
    reread.drop(String("a"));
    assert !reread.contains(String("a")) && reread.contains(String("b"));
    const Vector<String> names = reread.getNames();
    assert names.getSize() == 2l && names.get(0l) == "b";
    return true;
}

#[test]
f<bool> testLockfileInvalid() {
    Lockfile wrongVersion;
    String error;
    assert !wrongVersion.parse(String("version = 2\n"), error);
    Lockfile badName;
    assert !badName.parse(String("version = 1\n[[package]]\nname = \"../evil\"\nsource = \"registry\"\n"), error);
    Lockfile empty;
    assert empty.parse(String("version = 1\npackage = []\n"), error);
    return true;
}

#[test]
f<bool> testLockfileCopyIsIndependent() {
    Lockfile original;
    LockEntry a;
    a.name = String("a");
    a.source = String("registry");
    a.version = String("1.0.0");
    original.set(a);
    Lockfile copy = original;
    a.version = String("2.0.0");
    copy.set(a);
    LockEntry b;
    b.name = String("b");
    b.source = String("registry");
    copy.set(b);
    copy.drop(String("a"));
    assert original.contains(String("a")) && !original.contains(String("b"));
    const LockEntry originalA = original.get(String("a"));
    assert originalA.version == "1.0.0";
    assert copy.entries.getSize() == 1l && original.entries.getSize() == 1l;
    return true;
}
