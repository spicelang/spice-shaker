import "std/net/http";
import "std/net/http-client";
import "std/os/env";
import "std/os/cmd";
import "./util";
import "./json";

// ---------------------------------------------------------------------------------------------------------------------
// Client for the JSON API of the Spice Rack package registry
// ---------------------------------------------------------------------------------------------------------------------

public const string DEFAULT_REGISTRY_URL = "https://rack.spicelang.com";
public const string REGISTRY_URL_ENV = "SPICE_RACK_URL";

/**
 * Outcome of a request to the registry. `error` is empty on success.
 */
public type Reply struct {
    public int status = 0
    public String body
    public String error
}

public f<bool> Reply.ok() {
    return this.error.isEmpty();
}

public type Registry struct {
    public String baseUrl
    public HttpClient client
}

public p Registry.ctor() {
    this.baseUrl = String(DEFAULT_REGISTRY_URL);
    Result<string> custom = getEnv(REGISTRY_URL_ENV);
    if custom.isOk() {
        String url = String(custom.unwrap());
        while url.endsWith("/") { url = url.getSubstring(0l, cast<long>(url.getLength()) - 1l); }
        if !url.isEmpty() { this.baseUrl = url; }
    }
    this.client.setDefaultHeader("Accept", "application/json");
    this.client.setDefaultHeader("User-Agent", "spice-shaker");
}

/**
 * GET a path of the registry and parse the JSON answer into `doc`
 */
public f<Reply> Registry.getJson(const String& path, JV& doc) {
    Reply reply;
    const String url = this.baseUrl + path;
    Result<HttpResponse> response = this.client.get(url.getRaw());
    if response.isErr() {
        reply.error = String("Could not reach the registry at ") + this.baseUrl + " (" + response.getErr().message +
                      "). Set " + REGISTRY_URL_ENV + " to use another registry.";
        return reply;
    }
    HttpResponse& answer = response.unwrap();
    reply.status = cast<int>(answer.statusCode);
    reply.body = answer.body;
    doc = parseDoc(answer.body);
    if answer.statusCode != STATUS_OK {
        String message = doc.getStr("error");
        if message.isEmpty() { message = String("HTTP status ") + fmtLong(cast<long>(answer.statusCode)); }
        reply.error = message;
    } else if !doc.exists() {
        reply.error = String("The registry sent an invalid answer");
    }
    return reply;
}

public f<Reply> Registry.getPackage(const String& name, JV& doc) {
    return this.getJson(String("/api/v1/packages/") + encodeQuery(name), doc);
}

public f<Reply> Registry.search(const String& query, long page, JV& doc) {
    return this.getJson(String("/api/v1/packages?q=") + encodeQuery(query) + "&page=" + fmtLong(page), doc);
}

public f<String> Registry.downloadUrl(const String& name, const String& version) {
    return this.baseUrl + "/api/v1/packages/" + encodeQuery(name) + "/versions/" + encodeQuery(version) + "/download";
}

/**
 * Download a file to disk. The std http client keeps bodies in strings, which cannot hold binary data like archives,
 * so this delegates to curl (which ships with Linux, macOS and Windows 10+) and follows the registry's redirect
 * to the GitHub archive.
 */
public f<bool> downloadFile(const String& url, const String& destination) {
    const String command = String("curl -fsSL -o \"") + destination + "\" \"" + url + "\"";
    return execCmd(command) == 0;
}
