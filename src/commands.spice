// Std imports
import "std/data/pair";
import "std/data/vector";
import "std/io/file";
import "std/io/filepath";
import "std/os/filesystem";
import "std/text/print";
import "std/type/type-conversion";

// Own imports
import "./util";
import "./semver";
import "./manifest";
import "./lockfile";
import "./registry";
import "./installer";

// ---------------------------------------------------------------------------------------------------------------------
// The commands of Spice Shaker. Each one returns the exit code of the process.
// ---------------------------------------------------------------------------------------------------------------------

const int EXIT_OK = 0;
const int EXIT_FAILED = 1;

/**
 * What `install` was asked to add
 */
public type InstallRequest struct {
    public String target     // Package name, owner/repo or path
    public String version    // --version
    public String rev        // --rev
    public String name       // --as
    public bool github = false
    public bool path = false
    public bool dev = false
}

p printErrors(const Vector<String>& errors) {
    for unsigned long i = 0l; i < errors.getSize(); i++ { println(String("error: ") + errors.get(i)); }
}

f<bool> loadProject(Manifest& manifest) {
    if !fileExists(MANIFEST_FILE) {
        println(String("error: No ") + MANIFEST_FILE + " found in the current directory. Run 'spice-shaker init' first.");
        return false;
    }
    Vector<String> errors;
    if loadManifest(String(MANIFEST_FILE), String(MANIFEST_FILE), manifest, errors) { return true; }
    printErrors(errors);
    return false;
}

/**
 * Remove packages that are not needed anymore and write the lock file. This also runs after a failure, so that packages
 * installed by the failed run do not stay behind.
 */
f<int> finish(Installer& installer, const Manifest& manifest, bool ok, bool reportUpToDate = false) {
    installer.prune(manifest);
    if !installer.lock.save() {
        println(String("error: Could not write ") + LOCK_FILE);
        return EXIT_FAILED;
    }
    if !ok { return EXIT_FAILED; }
    if reportUpToDate && installer.changes == 0u { println("Everything is up to date."); }
    return EXIT_OK;
}

const string GITIGNORE_FILE = ".gitignore";

/**
 * Content of a .gitignore that excludes the packages directory. Returns the content unchanged if it does so already.
 */
f<String> ignorePackagesDir(const String& content) {
    const Vector<String> lines = splitLines(content);
    for unsigned long i = 0l; i < lines.getSize(); i++ {
        const String& line = lines.get(i);
        String pattern = line.trim();
        if pattern.startsWith("/") { pattern = pattern.getSubstring(1l); }
        if pattern.endsWith("/") { pattern = pattern.getSubstring(0l, cast<long>(pattern.getLength()) - 1l); }
        if pattern == PACKAGES_DIR { return content; }
    }
    // Keep the line breaks of the file
    const string lineBreak = content.contains("\r\n") ? "\r\n" : "\n";
    String updated = content;
    if !updated.isEmpty() && !updated.endsWith("\n") { updated += lineBreak; }
    return updated + "/" + PACKAGES_DIR + "/" + lineBreak;
}

/**
 * Make sure that git ignores the packages directory, creating the .gitignore if there is none
 */
f<bool> ensurePackagesDirIgnored() {
    String content;
    if fileExists(GITIGNORE_FILE) {
        Result<String> existing = readBinaryFile(String(GITIGNORE_FILE));
        if existing.isErr() { return false; }
        content = existing.unwrap();
    }
    const String updated = ignorePackagesDir(content);
    if updated == content { return true; }
    if !writeTextFile(String(GITIGNORE_FILE), updated) { return false; }
    println(String(content.isEmpty() ? "Created " : "Updated ") + GITIGNORE_FILE + " to exclude " + PACKAGES_DIR + "/.");
    return true;
}

public f<int> runInit() {
    if fileExists(MANIFEST_FILE) {
        println(String("error: ") + MANIFEST_FILE + " exists already");
        return EXIT_FAILED;
    }
    const FilePath cwd = FilePath(getCurrentWorkingDir());
    Manifest manifest;
    manifest.name = sanitizeName(cwd.getFileName());
    if manifest.name.isEmpty() { manifest.name = String("my-package"); }
    manifest.version = String("0.1.0");
    if !writeTextFile(String(MANIFEST_FILE), renderManifest(manifest)) {
        println(String("error: Could not write ") + MANIFEST_FILE);
        return EXIT_FAILED;
    }
    println(String("Created ") + MANIFEST_FILE + " for '" + manifest.name + "'.");
    if !ensurePackagesDirIgnored() {
        println(String("warning: Could not update ") + GITIGNORE_FILE + ". Add '/" + PACKAGES_DIR + "/' to it yourself.");
    }
    println(String("Commit ") + MANIFEST_FILE + " and " + LOCK_FILE + ", but not " + PACKAGES_DIR + "/.");
    return EXIT_OK;
}

/**
 * Turn the arguments of `install` into the dependency to add. The version of a registry dependency is decided after
 * resolving, if it was not given.
 */
f<bool> buildDependency(const InstallRequest& request, Dependency& dep) {
    if request.github && request.path {
        println("error: --github and --path cannot be combined");
        return false;
    }
    if !request.rev.isEmpty() && !request.github {
        println("error: --rev is only allowed with --github");
        return false;
    }
    if !request.version.isEmpty() && (request.github || request.path) {
        println(String("error: --version is only allowed for registry packages") + (request.github ? ", use --rev" : ""));
        return false;
    }
    if !request.name.isEmpty() && !request.github && !request.path {
        println("error: --as is only allowed with --github or --path");
        return false;
    }
    String name = request.name;
    if request.github {
        if !isValidGithubRepo(request.target) {
            println(String("error: Expected owner/repo for --github, got '") + request.target + "'");
            return false;
        }
        if !request.rev.isEmpty() && !isValidGitRef(request.rev) {
            println(String("error: '") + request.rev + "' is not a valid git ref");
            return false;
        }
        if name.isEmpty() {
            const long slash = request.target.find('/');
            name = sanitizeName(request.target.getSubstring(cast<unsigned long>(slash) + 1l));
        }
        dep = githubDependency(name, request.target, request.rev);
    } else if request.path {
        String path = request.target;
        path.replaceAll('\\', '/');
        while path.getLength() > 1l && path.endsWith("/") { path = path.getSubstring(0l, cast<long>(path.getLength()) - 1l); }
        if name.isEmpty() {
            Manifest target;
            Vector<String> errors;
            const String manifestPath = path + "/" + MANIFEST_FILE;
            if !fileExists(manifestPath.getRaw()) {
                println(String("error: ") + path + " has no " + MANIFEST_FILE);
                return false;
            }
            if !loadManifest(manifestPath, manifestPath, target, errors) {
                printErrors(errors);
                return false;
            }
            name = target.name;
        }
        dep = pathDependency(name, path);
    } else {
        name = request.target;
        if !request.version.isEmpty() && !isValidConstraint(request.version) {
            println(String("error: '") + request.version + "' is not a valid version constraint");
            return false;
        }
        dep = registryDependency(name, request.version.isEmpty() ? String("*") : request.version);
    }
    if !isValidPackageName(name) {
        println(String("error: '") + name + "' is not a valid package name" + (request.name.isEmpty() && (request.github || request.path) ? ", choose one with --as" : ""));
        return false;
    }
    dep.dev = request.dev;
    return true;
}

public f<int> runInstall(const InstallRequest& request) {
    Manifest manifest;
    if !loadProject(manifest) { return EXIT_FAILED; }
    Dependency dep;
    if !buildDependency(request, dep) { return EXIT_FAILED; }
    Installer installer;
    if !installer.loadLock() { return EXIT_FAILED; }

    // Resolve with the new dependency in a copy of the manifest, which is only saved if that works
    Manifest planned = manifest;
    Vector<String> errors;
    if !planned.setDependency(dep, errors) { printErrors(errors); return EXIT_FAILED; }
    println(String("Installing ") + dep.name + " ...");
    if !installer.resolve(planned) { return finish(installer, manifest, false); }

    if dep.source == DependencySource::REGISTRY && request.version.isEmpty() {
        // Record a compatible range of the version that was picked
        const LockEntry entry = installer.lock.get(dep.name);
        const Semver picked = parseSemver(entry.version);
        dep.version = picked.valid && picked.pre.isEmpty() ? String("^") + picked.toString() : entry.version;
        if !planned.setDependency(dep, errors) { printErrors(errors); return finish(installer, manifest, false); }
    }
    if !planned.save() {
        println(String("error: Could not write ") + MANIFEST_FILE);
        return finish(installer, manifest, false);
    }
    println(String("Added ") + dep.name + " (" + dep.describe() + ") to [" + (dep.dev ? "dev-dependencies" : "dependencies") + "].");
    const String entry = installer.entries.contains(dep.name) ? installer.entries.get(dep.name) : String(DEFAULT_ENTRY);
    const String entryPath = packagePath(dep.name) + "/" + entry;
    if fileExists(entryPath.getRaw()) {
        // Imports are written without the file extension
        const String importPath = entryPath.getSubstring(0l, cast<long>(entryPath.getLength()) - 6l);
        println(String("Import it with: import \"") + importPath + "\";");
    } else {
        println(String("Import its files with: import \"") + packagePath(dep.name) + "/<file>\";");
    }
    return finish(installer, planned, true);
}

f<int> installAll(bool preferLocked) {
    Manifest manifest;
    if !loadProject(manifest) { return EXIT_FAILED; }
    Installer installer;
    if !installer.loadLock() { return EXIT_FAILED; }
    installer.preferLocked = preferLocked;
    const bool ok = installer.resolve(manifest);
    return finish(installer, manifest, ok, true);
}

/**
 * Install what the manifest asks for, preferring the versions of the lock file
 */
public f<int> runSync() {
    return installAll(true);
}

/**
 * Re-resolve all dependencies to the newest versions and commits their specifications allow
 */
public f<int> runUpdate() {
    return installAll(false);
}

public f<int> runUninstall(const String& name) {
    Manifest manifest;
    if !loadProject(manifest) { return EXIT_FAILED; }
    Installer installer;
    if !installer.loadLock() { return EXIT_FAILED; }
    if manifest.indexOf(name) < 0l {
        if installer.lock.contains(name) {
            println(String("error: '") + name + "' is not a direct dependency, another package needs it");
        } else {
            println(String("error: '") + name + "' is not a dependency");
        }
        return EXIT_FAILED;
    }
    Vector<String> errors;
    if !manifest.removeDependency(name, errors) { printErrors(errors); return EXIT_FAILED; }
    if !manifest.save() {
        println(String("error: Could not write ") + MANIFEST_FILE);
        return EXIT_FAILED;
    }
    println(String("Removed ") + name + " from " + MANIFEST_FILE + ".");
    const int exitCode = finish(installer, manifest, true);
    if installer.lock.contains(name) { println(String("note: ") + name + " stays installed, because other packages need it."); }
    return exitCode;
}

p printTree(const Lockfile& lock, const String& name, const String& spec, const String& indent, Vector<String>& path) {
    const LockEntry entry = lock.get(name);
    String line = indent + name;
    if !lock.contains(name) {
        line += " (not installed)";
    } else if entry.isPath() {
        line += String(" -> ") + entry.display();
    } else {
        line += String("@") + entry.display();
        if !spec.isEmpty() { line += String("  [") + spec + "]"; }
    }
    if containsString(path, name) {
        println(line + "  (cycle)");
        return;
    }
    println(line);
    path.pushBack(name);
    for unsigned long i = 0l; i < entry.dependencies.getSize(); i++ {
        printTree(lock, entry.dependencies.get(i), String(""), indent + "  ", path);
    }
    path.popBack();
}

public f<int> runList() {
    Manifest manifest;
    if !loadProject(manifest) { return EXIT_FAILED; }
    Lockfile lock;
    String error;
    if !lock.load(error) {
        println(String("error: ") + error);
        return EXIT_FAILED;
    }
    println(manifest.name + "@" + manifest.version);
    if !manifest.hasDependencies() {
        println("  no dependencies");
        return EXIT_OK;
    }
    bool devHeaderPrinted = false;
    for unsigned long i = 0l; i < manifest.dependencies.getSize(); i++ {
        const Dependency& dep = manifest.dependencies.get(i);
        if dep.dev && !devHeaderPrinted {
            println("  dev:");
            devHeaderPrinted = true;
        }
        Vector<String> path;
        printTree(lock, dep.name, dep.describe(), String(dep.dev ? "    " : "  "), path);
    }
    return EXIT_OK;
}

public f<int> runSearch(const String& query, long page) {
    Registry registry;
    SearchResult found;
    const Reply reply = registry.search(query, page, found);
    if !reply.ok() {
        println(String("error: ") + reply.error);
        return EXIT_FAILED;
    }
    if found.packages.isEmpty() {
        println(String("No packages found for '") + query + "'.");
        return EXIT_OK;
    }
    for unsigned long i = 0l; i < found.packages.getSize(); i++ {
        const PackageSummary& item = found.packages.get(i);
        const String version = item.latestVersion.isEmpty() ? String("-") : item.latestVersion;
        println(padRight(item.name, 24l) + padRight(version, 10l) + shortened(item.description, 60l));
    }
    println(String("\n") + toString(found.total) + " package(s) in total, page " + toString(found.page));
    return EXIT_OK;
}

public f<int> runInfo(const String& name) {
    if !isValidPackageName(name) {
        println(String("error: '") + name + "' is not a valid package name");
        return EXIT_FAILED;
    }
    Registry registry;
    PackageDetails details;
    const Reply reply = registry.getPackage(name, details);
    if !reply.ok() {
        if reply.status == 404 { println(String("error: Package '") + name + "' was not found in the registry"); }
        else { println(String("error: ") + reply.error); }
        return EXIT_FAILED;
    }
    const PackageSummary& info = details.info;
    println(info.name + "@" + (info.latestVersion.isEmpty() ? String("-") : info.latestVersion));
    println(info.description);
    println("");
    println(String("repository:  ") + info.repository);
    if !info.homepage.isEmpty() { println(String("homepage:    ") + info.homepage); }
    if !info.license.isEmpty() { println(String("license:     ") + info.license); }
    println(String("maintainer:  ") + info.maintainer);
    println(String("downloads:   ") + toString(info.downloads));
    String tagLine;
    for unsigned long i = 0l; i < info.tags.getSize(); i++ {
        if i > 0l { tagLine += ", "; }
        tagLine += info.tags.get(i);
    }
    if !tagLine.isEmpty() { println(String("tags:        ") + tagLine); }

    const unsigned long versionCount = details.versions.getSize();
    if versionCount == 0l {
        println("\nNo releases yet.");
        return EXIT_OK;
    }
    println("\nVersions:");
    for unsigned long i = 0l; i < versionCount && i < 10l; i++ {
        PackageVersion& version = details.versions.get(i);
        String line = String("  ") + padRight(version.version, 14l) + head(version.publishedAt, 10l);
        if version.prerelease { line += "  (pre-release)"; }
        println(line);
        if i > 0l { continue; }
        // The requirements of the newest version
        foreach Pair<const String&, String&> dependency : version.dependencies {
            println(String("      requires ") + dependency.getFirst() + " " + dependency.getSecond());
        }
    }
    if versionCount > 10l { println(String("  ... and ") + toString(cast<long>(versionCount) - 10l) + " more"); }
    return EXIT_OK;
}

#[test]
f<bool> testIgnorePackagesDir() {
    assert ignorePackagesDir(String("")) == "/spice_packages/\n";
    assert ignorePackagesDir(String("/build")) == "/build\n/spice_packages/\n";
    assert ignorePackagesDir(String("a\r\nb\r\n")) == "a\r\nb\r\n/spice_packages/\r\n";
    const String alreadyIgnored = String("# deps\nspice_packages\n");
    assert ignorePackagesDir(alreadyIgnored) == alreadyIgnored;
    const String anchored = String("/spice_packages/\n");
    assert ignorePackagesDir(anchored) == anchored;
    return true;
}
