// Std imports
import "std/text/json/json-value";
import "std/text/json/json-parser";

// ---------------------------------------------------------------------------------------------------------------------
// Lenient accessors for JSON from the registry. The std accessors panic on a wrong kind;
// these read a missing value, or one of another kind, as nil / "" / 0 / false.
// ---------------------------------------------------------------------------------------------------------------------

/**
 * Parse a JSON text. Returns nil if it is not valid JSON. The caller releases the tree with deleteJsonValue.
 */
public f<JsonValue*> parseJsonOrNil(const String& text) {
    Result<JsonValue*> parsed = parseJson(text);
    if parsed.isErr() { return nil<JsonValue*>; }
    return parsed.unwrap();
}

public f<JsonValue*> jsonField(JsonValue* object, string key) {
    if object == nil<JsonValue*> || !object.isObject() || !object.hasField(key) { return nil<JsonValue*>; }
    return object.getField(key);
}

public f<String> jsonText(JsonValue* value) {
    if value == nil<JsonValue*> || !value.isString() { return String(""); }
    return value.getString();
}

public f<String> jsonString(JsonValue* object, string key) {
    return jsonText(jsonField(object, key));
}

public f<long> jsonLong(JsonValue* object, string key) {
    JsonValue* value = jsonField(object, key);
    if value == nil<JsonValue*> || !value.isNumber() { return 0l; }
    if value.hasUnsignedIntegerValue() { return cast<long>(value.getUnsignedInteger()); }
    return cast<long>(value.getNumber());
}

public f<bool> jsonBool(JsonValue* object, string key) {
    JsonValue* value = jsonField(object, key);
    return value != nil<JsonValue*> && value.isBool() && value.getBool();
}

/**
 * Number of items of an array or members of an object, 0 for everything else
 */
public f<unsigned long> jsonSize(JsonValue* value) {
    if value == nil<JsonValue*> { return 0l; }
    if value.isArray() { return value.getArraySize(); }
    if value.isObject() { return value.getObjectSize(); }
    return 0l;
}

#[test]
f<bool> testJsonAccessors() {
    JsonValue* doc = parseJsonOrNil(String("{\"a\": 1, \"b\": [true, \"x\"], \"c\": {\"d\": \"e\"}, \"f\": true}"));
    assert doc != nil<JsonValue*>;
    assert jsonLong(doc, "a") == 1l;
    assert jsonSize(jsonField(doc, "b")) == 2l;
    assert jsonString(jsonField(doc, "c"), "d") == "e";
    assert jsonBool(doc, "f");
    // Missing values and wrong kinds read as empty
    assert jsonString(doc, "a") == "";
    assert jsonString(jsonField(doc, "missing"), "deep") == "";
    assert jsonLong(jsonField(doc, "b"), "x") == 0l;
    deleteJsonValue(doc);
    assert parseJsonOrNil(String("{\"a\": ")) == nil<JsonValue*>;
    return true;
}
