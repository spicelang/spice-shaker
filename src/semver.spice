// Std imports
import "std/data/vector";
import "std/text/analysis";
import "std/text/string-ext";
import "std/type/type-conversion";

// Own imports
import "./util";

// ---------------------------------------------------------------------------------------------------------------------
// Semantic versions and version constraints (same rules as the Spice Rack registry)
//
// Supported clauses, which can be combined with commas or spaces (all of them have to match):
//   *          any version             1.2.3     exactly 1.2.3 (also =1.2.3)
//   ^1.2.3     >=1.2.3 <2.0.0          ~1.2.3    >=1.2.3 <1.3.0
//   1.2.x      same as ~1.2.0          1.x       same as ^1.0.0
//   >=1.2.3  >1.2.3  <=1.2.3  <1.2.3
// ---------------------------------------------------------------------------------------------------------------------

public type Semver struct {
    public long major = 0l
    public long minor = 0l
    public long patch = 0l
    public String pre
    public bool valid = false
}

f<long> parseNumber(const String& text) {
    if text.isEmpty() || text.getLength() > 18l { return -1l; }
    for unsigned long i = 0l; i < text.getLength(); i++ {
        if !isDigit(text[i]) { return -1l; }
    }
    return toLong(text.getRaw());
}

/**
 * Parse "1.2.3", "v1.2.3", "1.2", "1.2.3-beta.1" or "1.2.3+build". Build metadata is dropped.
 */
public f<Semver> parseSemver(const String& input) {
    Semver version;
    String text = input.trim();
    if text.startsWith("v") || text.startsWith("V") { text = text.getSubstring(1l); }
    const long plus = text.find('+');
    if plus >= 0l { text = text.getSubstring(0l, plus); }
    const long dash = text.find('-');
    if dash >= 0l {
        version.pre = text.getSubstring(cast<unsigned long>(dash) + 1l);
        text = text.getSubstring(0l, dash);
        if version.pre.isEmpty() { return version; }
    }
    const Vector<String> parts = split(text, '.');
    if parts.getSize() > 3l { return version; }
    for unsigned long i = 0l; i < parts.getSize(); i++ {
        const long number = parseNumber(parts.get(i));
        if number < 0l { return version; }
        if i == 0l { version.major = number; }
        else if i == 1l { version.minor = number; }
        else { version.patch = number; }
    }
    version.valid = true;
    return version;
}

/**
 * A complete version as required for package.version: three numbers, no leading 'v'
 */
public f<bool> isStrictSemver(const String& input) {
    if input.startsWith("v") || input.startsWith("V") || input != input.trim() { return false; }
    String core = input;
    const long plus = core.find('+');
    if plus >= 0l { core = core.getSubstring(0l, plus); }
    const long dash = core.find('-');
    if dash >= 0l { core = core.getSubstring(0l, dash); }
    const Vector<String> parts = split(core, '.');
    return parts.getSize() == 3l && parseSemver(input).valid;
}

public f<String> Semver.toString() {
    String text = toString(this.major) + "." + toString(this.minor) + "." + toString(this.patch);
    if !this.pre.isEmpty() { text += "-" + this.pre; }
    return text;
}

f<int> compareIdentifiers(const String& a, const String& b) {
    // Pre-release identifiers are compared piece by piece, numerically where both are numbers
    const Vector<String> pa = split(a, '.');
    const Vector<String> pb = split(b, '.');
    const unsigned long n = pa.getSize() < pb.getSize() ? pa.getSize() : pb.getSize();
    for unsigned long i = 0l; i < n; i++ {
        const long na = parseNumber(pa.get(i));
        const long nb = parseNumber(pb.get(i));
        if na >= 0l && nb >= 0l {
            if na != nb { return na < nb ? -1 : 1; }
        } else if na >= 0l {
            return -1;
        } else if nb >= 0l {
            return 1;
        } else if pa.get(i) != pb.get(i) {
            return isStringBefore(pa.get(i), pb.get(i)) ? -1 : 1;
        }
    }
    if pa.getSize() == pb.getSize() { return 0; }
    return pa.getSize() < pb.getSize() ? -1 : 1;
}

/**
 * Returns -1, 0 or 1. A pre-release sorts before its release.
 */
public f<int> compareSemver(const Semver& a, const Semver& b) {
    if a.major != b.major { return a.major < b.major ? -1 : 1; }
    if a.minor != b.minor { return a.minor < b.minor ? -1 : 1; }
    if a.patch != b.patch { return a.patch < b.patch ? -1 : 1; }
    if a.pre.isEmpty() && b.pre.isEmpty() { return 0; }
    if a.pre.isEmpty() { return 1; }
    if b.pre.isEmpty() { return -1; }
    return compareIdentifiers(a.pre, b.pre);
}

/**
 * A single clause like ">=1.2.3", "^1.2", "~2.0.1", "1.2.x" or "*", turned into a range [lower, upper).
 * A missing upper bound is marked by upper.valid == false.
 */
type Clause struct {
    public bool valid = false
    public bool any = false
    public String op       // "", "=", ">=", ">", "<=", "<"; ranges (^, ~, wildcards) are turned into lower/upper
    public Semver lower
    public Semver upper
}

f<Clause> parseClause(const String& input) {
    Clause clause;
    String text = input.trim();
    if text.isEmpty() || text == "*" || text == "x" || text == "X" {
        clause.valid = true;
        clause.any = true;
        return clause;
    }
    if text.startsWith(">=") || text.startsWith("<=") {
        clause.op = text.getSubstring(0l, 2l);
        clause.lower = parseSemver(text.getSubstring(2l));
        clause.valid = clause.lower.valid;
        return clause;
    }
    if text.startsWith(">") || text.startsWith("<") || text.startsWith("=") {
        clause.op = text.getSubstring(0l, 1l);
        text = text.getSubstring(1l);
        if clause.op != "=" {
            clause.lower = parseSemver(text);
            clause.valid = clause.lower.valid;
            return clause;
        }
        clause.op = String("");
    }

    const bool caret = text.startsWith("^");
    const bool tilde = text.startsWith("~");
    if caret || tilde { text = text.getSubstring(1l); }

    // Wildcards: "1.x", "1.2.*"
    bool wildcard = false;
    const Vector<String> pieces = split(text, '.');
    String concrete;
    unsigned long given = 0l;
    for unsigned long i = 0l; i < pieces.getSize(); i++ {
        const String& piece = pieces.get(i);
        if piece == "x" || piece == "X" || piece == "*" {
            // Everything after a wildcard has to be a wildcard as well
            for unsigned long k = i; k < pieces.getSize(); k++ {
                const String& rest = pieces.get(k);
                if rest != "x" && rest != "X" && rest != "*" { return clause; }
            }
            wildcard = true;
            break;
        }
        if i > 0l { concrete += "."; }
        concrete += piece;
        given++;
    }
    if wildcard && (caret || tilde || given == 0l) { return clause; }
    clause.lower = parseSemver(concrete);
    if !clause.lower.valid { return clause; }
    clause.valid = true;

    if !caret && !tilde && !wildcard {
        clause.op = String("=");
        return clause;
    }
    clause.upper.valid = true;
    if wildcard || tilde {
        if given == 1l { clause.upper.major = clause.lower.major + 1l; }
        else { clause.upper.major = clause.lower.major; clause.upper.minor = clause.lower.minor + 1l; }
    } else {
        // Caret: everything up to the next change of the left-most non-zero number
        if clause.lower.major > 0l || given == 1l { clause.upper.major = clause.lower.major + 1l; }
        else if clause.lower.minor > 0l || given == 2l { clause.upper.minor = clause.lower.minor + 1l; }
        else { clause.upper.patch = clause.lower.patch + 1l; }
    }
    return clause;
}

f<bool> Clause.matches(const Semver& version) {
    if this.any { return true; }
    const int cmp = compareSemver(version, this.lower);
    if this.op == "=" { return cmp == 0; }
    if this.op == ">=" { return cmp >= 0; }
    if this.op == ">" { return cmp > 0; }
    if this.op == "<=" { return cmp <= 0; }
    if this.op == "<" { return cmp < 0; }
    return cmp >= 0 && (!this.upper.valid || compareSemver(version, this.upper) < 0);
}

/**
 * Split a constraint expression into clauses. Operators written with a space (">= 1.2") are joined with their version.
 */
f<Vector<String>> splitClauses(const String& constraint) {
    String normalized = constraint;
    normalized.replaceAll(',', ' ');
    const Vector<String> tokens = split(normalized, ' ');
    Vector<String> clauses;
    String pendingOperator;
    for unsigned long i = 0l; i < tokens.getSize(); i++ {
        const String& token = tokens.get(i);
        if token.isEmpty() { continue; }
        const bool operatorOnly = token == ">=" || token == "<=" || token == ">" || token == "<" || token == "=" ||
                                  token == "^" || token == "~";
        if operatorOnly { pendingOperator = token; continue; }
        clauses.pushBack(pendingOperator + token);
        pendingOperator = String("");
    }
    if !pendingOperator.isEmpty() { clauses.pushBack(pendingOperator); }
    return clauses;
}

/**
 * Check whether a text is a valid constraint expression
 */
public f<bool> isValidConstraint(const String& constraint) {
    const String trimmed = constraint.trim();
    if trimmed.isEmpty() { return false; }
    const Vector<String> clauses = splitClauses(constraint);
    for unsigned long i = 0l; i < clauses.getSize(); i++ {
        const Clause clause = parseClause(clauses.get(i));
        if !clause.valid { return false; }
    }
    return true;
}

/**
 * Check a version against a constraint expression. Invalid constraints match nothing.
 */
public f<bool> satisfies(const Semver& version, const String& constraint) {
    if !version.valid { return false; }
    const Vector<String> clauses = splitClauses(constraint);
    for unsigned long i = 0l; i < clauses.getSize(); i++ {
        const Clause clause = parseClause(clauses.get(i));
        if !clause.valid || !clause.matches(version) { return false; }
    }
    return true;
}

/**
 * Pick the highest version out of a list that satisfies the constraint. Pre-releases are only considered if
 * nothing else matches. Returns the index into the list, or -1.
 */
public f<long> pickBestVersion(const Vector<String>& versions, const String& constraint) {
    long best = -1l;
    long bestPre = -1l;
    for unsigned long i = 0l; i < versions.getSize(); i++ {
        const Semver candidate = parseSemver(versions.get(i));
        if !satisfies(candidate, constraint) { continue; }
        const bool stable = candidate.pre.isEmpty();
        const long current = stable ? best : bestPre;
        bool better = current < 0l;
        if !better {
            const Semver currentVersion = parseSemver(versions.get(cast<unsigned long>(current)));
            better = compareSemver(candidate, currentVersion) > 0;
        }
        if better && stable { best = cast<long>(i); }
        if better && !stable { bestPre = cast<long>(i); }
    }
    return best >= 0l ? best : bestPre;
}

#[test]
f<bool> testSemverParse() {
    const Semver a = parseSemver(String("v1.2.3-beta.1+abc"));
    assert a.valid && a.major == 1l && a.minor == 2l && a.patch == 3l && a.pre == "beta.1";
    const Semver b = parseSemver(String("2"));
    assert b.valid && b.major == 2l && b.minor == 0l;
    assert !parseSemver(String("1.x")).valid;
    assert !parseSemver(String("abc")).valid;
    assert !parseSemver(String("1.2.3.4")).valid;
    assert !parseSemver(String("1..2")).valid;
    assert isStrictSemver(String("1.2.3"));
    assert isStrictSemver(String("1.2.3-rc.1"));
    assert !isStrictSemver(String("v1.2.3"));
    assert !isStrictSemver(String("1.2"));
    return true;
}

#[test]
f<bool> testSemverCompare() {
    assert compareSemver(parseSemver(String("1.2.3")), parseSemver(String("1.2.4"))) < 0;
    assert compareSemver(parseSemver(String("1.10.0")), parseSemver(String("1.9.0"))) > 0;
    assert compareSemver(parseSemver(String("1.0.0-alpha")), parseSemver(String("1.0.0"))) < 0;
    assert compareSemver(parseSemver(String("1.0.0-alpha.2")), parseSemver(String("1.0.0-alpha.10"))) < 0;
    assert compareSemver(parseSemver(String("1.0.0")), parseSemver(String("v1.0.0"))) == 0;
    return true;
}

#[test]
f<bool> testSemverConstraints() {
    const Semver v = parseSemver(String("1.4.2"));
    assert satisfies(v, String("*"));
    assert satisfies(v, String("1.4.2"));
    assert satisfies(v, String("=1.4.2"));
    assert !satisfies(v, String("1.4.3"));
    assert satisfies(v, String("^1.2.0"));
    assert satisfies(v, String("^1"));
    assert !satisfies(v, String("^2.0.0"));
    assert satisfies(v, String("~1.4.0"));
    assert !satisfies(v, String("~1.3.0"));
    assert satisfies(v, String("1.4.x"));
    assert satisfies(v, String("1.x"));
    assert !satisfies(v, String("2.x"));
    assert satisfies(v, String(">=1.0.0, <2.0.0"));
    assert satisfies(v, String(">= 1.0.0 < 1.5"));
    assert !satisfies(v, String(">1.4.2"));
    assert satisfies(parseSemver(String("0.2.5")), String("^0.2.1"));
    assert !satisfies(parseSemver(String("0.3.0")), String("^0.2.1"));
    assert satisfies(parseSemver(String("0.0.3")), String("^0.0.3"));
    assert !satisfies(parseSemver(String("0.0.4")), String("^0.0.3"));
    assert isValidConstraint(String("^1.2.0"));
    assert isValidConstraint(String(">=1.0.0, <2.0.0"));
    assert isValidConstraint(String("1.2.x"));
    assert isValidConstraint(String("*"));
    assert !isValidConstraint(String(""));
    assert !isValidConstraint(String("^1.x"));
    assert !isValidConstraint(String("1.x.3"));
    assert !isValidConstraint(String("latest"));
    assert !isValidConstraint(String(">="));
    return true;
}

#[test]
f<bool> testPickBest() {
    Vector<String> versions;
    versions.pushBack(String("v1.0.0"));
    versions.pushBack(String("v1.3.0"));
    versions.pushBack(String("v2.0.0"));
    versions.pushBack(String("v1.9.0-rc.1"));
    assert pickBestVersion(versions, String("^1.0.0")) == 1l;
    assert pickBestVersion(versions, String("*")) == 2l;
    assert pickBestVersion(versions, String("^3.0.0")) == -1l;
    assert pickBestVersion(versions, String(">=1.9.0-rc.0, <2.0.0")) == 3l;
    return true;
}
